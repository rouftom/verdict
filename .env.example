# verdict · environment template
#
# Copy to `.env` (mode 600) and fill in the providers you use. Never commit the
# real file. Every key below is a placeholder: no value belongs in git.

# Server
API_PORT=8010
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:8010
LOG_LEVEL=info
MAX_RUNS_IN_MEMORY=20
MAX_EVENTS_PER_RUN=2000

# Meta Model API (OpenAI-compatible)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=
META_VISION_MODEL=
META_SAM_MODEL=
META_VOICE_MODEL=
# Model catalogs come from each provider's own model endpoint. The
# <PROVIDER>_MODELS value below is a fallback used only when that endpoint
# fails (comma list or JSON array); leave it empty for no fallback.
# Optional explicit fallback model list (JSON array or comma list).
META_MODELS=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODELS=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=
GOOGLE_BASE_URL=
GOOGLE_MODELS=

# xAI / Grok
XAI_API_KEY=
# GROK_API_KEY=
XAI_BASE_URL=
XAI_MODELS=

# Runware
RUNWARE_API_KEY=
RUNWARE_BASE_URL=
# AIR ids, e.g. google:gemini@4-argon,deepseek:v4.1@flash-1017
RUNWARE_MODELS=

# Groq (OpenAI-compatible)
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODELS=

# Nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODELS=

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b

# Ollama (local, OpenAI-compatible)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_MODELS=

# Other carried-over endpoints
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=
MODAL_ENDPOINT_URL=
MUSE_GLIMMER_MODEL=

# GitHub (raises the API rate limit; optional)
GITHUB_TOKEN=

# Transcription: any OpenAI-compatible /audio/transcriptions endpoint
# Provider-agnostic. Groq is only one possible value; nothing is hard-coded.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Target length of each audio chunk, in seconds.
TRANSCRIPTION_SEGMENT_SECONDS=30

# YouTube harvesting
# Base64 of a Netscape cookies.txt, written to a private temp file at runtime.
YTDLP_COOKIES_BASE64=
# Optional yt-dlp client impersonation, e.g. chrome or Safari-18.0.
YTDLP_IMPERSONATE=
# Optional yt-dlp --extractor-args, e.g. youtube:player_client=web.
YTDLP_EXTRACTOR_ARGS=
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_MINUTES=20
FRAME_MAX=24
MAX_REPO_BYTES=62914560

# Agent models: comma-separated `provider:model`
# Model catalogs come from each provider's model endpoint. An entry that the
# provider no longer returns is dropped; an empty or fully stale pool cycles the
# discovered catalog.
# EVAL_MODELS=anthropic:claude-sonnet-5-5,openai:gpt-5.5
EVAL_MODELS=
VERIFIER_MODELS=

# Provider model discovery
# Successful list cache, in seconds.
PROVIDER_MODELS_TTL_SECONDS=600
# Failed list cache, in seconds.
PROVIDER_MODELS_ERROR_TTL_SECONDS=60
# Per-provider model request timeout, in milliseconds.
PROVIDER_MODELS_TIMEOUT_MS=6000

# Reasoning effort, per provider
# Values: none | minimal | low | medium | high | xhigh | max
# Anthropic and Google also accept a token budget (e.g. 4096).
# REASONING_EFFORT_<PROVIDER> wins; REASONING_EFFORT is the fallback.
# Each provider maps the value to its own knob: Anthropic `effort`/thinking
# budget, Google `thinkingLevel`/`thinkingBudget`, OpenAI, xAI, Groq, DeepSeek,
# Nebius, NVIDIA, Runware, Meta and Ollama `reasoning_effort`.
# Empty means "send no reasoning option".
REASONING_EFFORT=
REASONING_EFFORT_ANTHROPIC=
REASONING_EFFORT_OPENAI=
REASONING_EFFORT_GOOGLE=
REASONING_EFFORT_XAI=
REASONING_EFFORT_GROQ=
REASONING_EFFORT_DEEPSEEK=
REASONING_EFFORT_NEBIUS=
REASONING_EFFORT_NVIDIA=
REASONING_EFFORT_META=
REASONING_EFFORT_RUNWARE=
REASONING_EFFORT_OLLAMA=
