{
  "name": "verdict",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent evaluator: evidence-grounded scoring, consensus and ranking of hackathon projects.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "zod": "^4.6.7"
  },
  "scripts": {
