  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.17.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
